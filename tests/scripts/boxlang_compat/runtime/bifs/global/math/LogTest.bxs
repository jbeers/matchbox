// boxlang_compat: ortus/boxlang/runtime/bifs/global/math/LogTest.java
assert log( 1 ) == 0 : "testItReturnsLog one";
assert abs( log( 0.5 ) - ( -0.6931471805599453 ) ) < 0.0000001 : "testItReturnsLog half";
assert abs( ( 1 ).log() - 0 ) < 0.0000001 : "testItReturnsLogMember one";
assert abs( ( 0.5 ).log() - ( -0.6931471805599453 ) ) < 0.0000001 : "testItReturnsLogMember half";
