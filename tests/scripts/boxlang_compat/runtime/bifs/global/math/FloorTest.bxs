// boxlang_compat: ortus/boxlang/runtime/bifs/global/math/FloorTest.java
// testItReturnsFloor
assert floor( 1.2 ) == 1 : "testItReturnsFloor 1.2";
assert floor( 1.4 ) == 1 : "testItReturnsFloor 1.4";
assert floor( 1.5 ) == 1 : "testItReturnsFloor 1.5";
assert floor( 1.6 ) == 1 : "testItReturnsFloor 1.6";
assert floor( 1.9 ) == 1 : "testItReturnsFloor 1.9";
// testItReturnsFloorMember
assert ( 1.2 ).floor() == 1 : "testItReturnsFloorMember 1.2";
assert ( 1.9 ).floor() == 1 : "testItReturnsFloorMember 1.9";
