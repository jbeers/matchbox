// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/bifs/global/type/GetMetaDataTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// SKIPPED [boxlang_compat] (JVM-only, hard requirement): testStringMetadata
// asserts the raw Java Class object and testAbstractMethodInClassMeta loads a
// BoxLang class file for JVM class metadata.

// testDateTimeMetadata
dt = now();
result = getMetadata( dt );
assert isStruct( result ) : "testDateTimeMetadata is-struct";
assert structKeyExists( result, "class" ) : "testDateTimeMetadata class-key";

// testArrayMetadata
arr = [ 1, 2, 3 ];
result = getMetadata( arr );
assert isStruct( result ) : "testArrayMetadata is-struct";
assert structKeyExists( result, "class" ) : "testArrayMetadata class-key";
