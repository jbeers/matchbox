// boxlang_compat: ortus/boxlang/runtime/bifs/global/temporal/CreateDateTimeTest.java

// testBif
result = createDateTime( 2023, 12, 31, 12, 30, 30, 0 );
assert isDateObject( result ) : "testBif DateTime result";
assert dateTimeFormat( result, "yyyy" ) == "2023" : "testBif year";
assert dateTimeFormat( result, "M" ) == "12" : "testBif month";
assert dateTimeFormat( result, "d" ) == "31" : "testBif day";
assert dateTimeFormat( result, "H" ) == "12" : "testBif hour";
assert dateTimeFormat( result, "m" ) == "30" : "testBif minute";
assert dateTimeFormat( result, "s" ) == "30" : "testBif second";
assert dateTimeFormat( result, "n" ) == "0" : "testBif nanosecond";

// testBifTimezone
result = createDateTime( 2023, 12, 31, 12, 30, 30, 0, "utc" );
assert isDateObject( result ) : "testBifTimezone DateTime result";
assert dateTimeFormat( result, "yyyy" ) == "2023" : "testBifTimezone year";
assert dateTimeFormat( result, "M" ) == "12" : "testBifTimezone month";
assert dateTimeFormat( result, "d" ) == "31" : "testBifTimezone day";
assert dateTimeFormat( result, "H" ) == "12" : "testBifTimezone hour";
assert dateTimeFormat( result, "m" ) == "30" : "testBifTimezone minute";
assert dateTimeFormat( result, "s" ) == "30" : "testBifTimezone second";
assert dateTimeFormat( result, "n" ) == "0" : "testBifTimezone nanosecond";
