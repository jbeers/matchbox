// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/bifs/global/binary/BitAndTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// testBitwiseAndWithPositiveIntegers
result = bitAnd( 5, 3 );
assert result == 1 : "testBitwiseAndWithPositiveIntegers";

// testBitwiseAndWithNegativeIntegers
result = bitAnd( -5, -3 );
assert result == -7 : "testBitwiseAndWithNegativeIntegers";

// testBitwiseAndWithZero
result = bitAnd( 0, 10 );
assert result == 0 : "testBitwiseAndWithZero";

// testBitwiseAndWithLargeIntegers
result = bitAnd( 123456789, 987654321 );
assert result == 39471121 : "testBitwiseAndWithLargeIntegers";

// testBitwiseAndWithLongRangeValues
result = bitAnd( 2190225219, 3 );
assert result == 3 : "testBitwiseAndWithLongRangeValues";
