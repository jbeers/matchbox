// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/bifs/global/binary/BitOrTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// testBitwiseOrWithPositiveIntegers
result = bitOr( 5, 3 );
assert result == 7 : "testBitwiseOrWithPositiveIntegers";

// testBitwiseOrWithNegativeIntegers
result = bitOr( -5, -3 );
assert result == -1 : "testBitwiseOrWithNegativeIntegers";

// testBitwiseOrWithZero
result = bitOr( 0, 10 );
assert result == 10 : "testBitwiseOrWithZero";

// testBitwiseOrWithLargeIntegers
result = bitOr( 123456789, 987654321 );
assert result == 1071639989 : "testBitwiseOrWithLargeIntegers";

// testBitwiseOrWithLongRangeValues
result = bitOr( 2190225218, 1 );
assert result == 2190225219 : "testBitwiseOrWithLongRangeValues";
