// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/bifs/global/binary/BitMaskReadTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// testBitwiseMaskReadWithPositiveIntegers
result = bitMaskRead( 15, 1, 3 );
assert result == 7 : "testBitwiseMaskReadWithPositiveIntegers";

// testBitwiseMaskReadWithNegativeIntegers
result = bitMaskRead( -5, 1, 2 );
assert result == 1 : "testBitwiseMaskReadWithNegativeIntegers";

// testBitwiseMaskReadWithZero
result = bitMaskRead( 0, 2, 4 );
assert result == 0 : "testBitwiseMaskReadWithZero";

// testBitwiseMaskReadWithLargeIntegers
result = bitMaskRead( 123456789, 4, 10 );
assert result == 209 : "testBitwiseMaskReadWithLargeIntegers";

// testBitwiseMaskReadWithLongRangeValues
result = bitMaskRead( 2190225219, 4, 10 );
assert result == 756 : "testBitwiseMaskReadWithLongRangeValues";

// testBitwiseMaskReadWithInvalidLength
threw = false;
try {
    result = bitMaskRead( 5, 2, 32 );
} catch ( e ) {
    threw = true;
}
assert threw : "testBitwiseMaskReadWithInvalidLength";

// testBitwiseMaskReadWithInvalidStart
threw = false;
try {
    result = bitMaskRead( 5, 32, 3 );
} catch ( e ) {
    threw = true;
}
assert threw : "testBitwiseMaskReadWithInvalidStart";
