// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/bifs/global/binary/BitMaskSetTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// testBitwiseMaskSetWithPositiveIntegers
result = bitMaskSet( 5, 3, 2, 4 );
assert result == 13 : "testBitwiseMaskSetWithPositiveIntegers";

// testBitwiseMaskSetWithNegativeIntegers
result = bitMaskSet( -5, -3, 1, 3 );
assert result == -5 : "testBitwiseMaskSetWithNegativeIntegers";

// testBitwiseMaskSetWithZero
result = bitMaskSet( 0, 10, 2, 4 );
assert result == 40 : "testBitwiseMaskSetWithZero";

// testBitwiseMaskSetWithLargeIntegers
result = bitMaskSet( 123456789, 987654321, 5, 10 );
assert result == 123442741 : "testBitwiseMaskSetWithLargeIntegers";

// testBitwiseMaskSetWithLongRangeValues
result = bitMaskSet( 2190225219, 1023, 4, 10 );
assert result == 2190229491 : "testBitwiseMaskSetWithLongRangeValues";

// testBitwiseMaskSetWithInvalidLength
threw = false;
try {
    result = bitMaskSet( 5, 3, 2, 32 );
} catch ( e ) {
    threw = true;
}
assert threw : "testBitwiseMaskSetWithInvalidLength";

// testBitwiseMaskSetWithInvalidStart
threw = false;
try {
    result = bitMaskSet( 5, 3, 32, 4 );
} catch ( e ) {
    threw = true;
}
assert threw : "testBitwiseMaskSetWithInvalidStart";
