// boxlang_compat: ortus/boxlang/runtime/bifs/global/struct/StructFindTest.java
myStruct = { flea: "bar" };
assert StructFind( myStruct, "flea" ) == "bar" : "testFind";
threw = false;
try {
    StructFind( myStruct, "foo" );
} catch ( e ) {
    threw = true;
}
assert threw : "testFindMissing";
assert StructFind( myStruct, "foo", "default" ) == "default" : "testFindDefault";
