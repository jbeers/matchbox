// boxlang_compat: ortus/boxlang/runtime/bifs/global/i18n/ParseCurrencyTest.java

// testBif
assert parseCurrency( "$1.50", "en_US" ) == 1.50 : "testBif dollar";
assert parseCurrency( "1.50", "en_US" ) == 1.50 : "testBif plain-number";
assert parseCurrency( "£1.50", "English (UK)" ) == 1.50 : "testBif pound";
assert parseCurrency( "1.50", "China" ) == 1.50 : "testBif china-number";

// The JVM test builds this value with DecimalFormat for ar_JO. These code
// points preserve its Arabic-Indic digits, direction marks, and separators.
arFormatted = char( 8207 ) & char( 1633 ) & char( 1644 ) & char( 1632 ) & char( 1632 ) & char( 1632 ) & char( 1643 ) & char( 1637 ) & char( 1633 ) & char( 1632 ) & char( 160 ) & char( 1583 ) & "." & char( 1571 ) & "." & char( 8207 );
assert parseCurrency( arFormatted, "ar_JO" ) == 1000.51 : "testBif arabic-format";
assert parseCurrency( "¥1,000.51", "China" ) == 1000.51 : "testBif china-format";

threw = false;
try {
    result = parseCurrency( "blah", "en_US" );
} catch ( e ) {
    threw = true;
}
assert threw : "testBif invalid";

// testLSBif
assert lsParseCurrency( "$1.50", "en_US" ) == 1.50 : "testLSBif";
