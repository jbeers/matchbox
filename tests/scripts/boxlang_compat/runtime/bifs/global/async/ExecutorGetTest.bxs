// boxlang_compat: ortus/boxlang/runtime/bifs/global/async/ExecutorGetTest.java

// testGetDefaultExecutorAndSubmitTask
executor = executorGet();
future = executor.submit( () => {
    return "Task Done!";
} );
result = future.get();
assert result == "Task Done!" : "testGetDefaultExecutorAndSubmitTask";

// testGetDefaultExecutor
result = executorGet();
// SKIPPED [boxlang_compat] (JVM-only, hard requirement): the JVM-only
// BoxExecutor class assertion has no source-level equivalent.
assert result.name() == "io-tasks" : "testGetDefaultExecutor name";

