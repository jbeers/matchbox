assert result.name() == "test-get-custom" : "testGetCustomExecutor name";

// testGetNonExistentExecutorThrows
threw = false;
try {
    result = executorGet( "non-existent-executor" );
} catch ( e ) {
    threw = true;
}
assert threw : "testGetNonExistentExecutorThrows";
