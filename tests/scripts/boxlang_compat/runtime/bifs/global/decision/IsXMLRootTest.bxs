// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/bifs/global/decision/IsXMLRootTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

xmlString = "<rootNode><subNode attr="value" /></rootNode>";

// testDocument
result = isXMLRoot( xmlParse( xmlString ) );
assert result == false : "testDocument";

// testRootNode
result = isXMLRoot( xmlParse( xmlString ).rootNode );
assert result : "testRootNode";

// testElement
result = isXMLRoot( xmlParse( xmlString ).rootNode.subNode );
assert result == false : "testElement";

// testRandomNode
xml = xmlParse( xmlString );
search = xmlSearch( xml, "//@attr" );
result = isXMLRoot( search[1] );
assert result == false : "testRandomNode";

// testNonXMLVar
result = isXMLRoot( [] );
assert result == false : "testNonXMLVar";
