// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/bifs/global/decision/IsObjectTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// SKIPPED [boxlang_compat] (JVM-only, hard requirement): the remaining cases
// construct Java classes and Java collection types.

class CompatObject {}
assert isObject( new CompatObject() ) : "testTrueConditions BoxLang class";

// testFalseConditions
result1 = isObject( "test" );
result2 = isObject( 53 );
result3 = isObject( {} );
result4 = isObject( [] );
result5 = isObject( queryNew( "" ) );
result6 = isObject( now() );
result7 = isObject( true );
result8 = isObject( 45.67 );
assert result1 == false : "testFalseConditions string";
assert result2 == false : "testFalseConditions integer";
assert result3 == false : "testFalseConditions struct";
assert result4 == false : "testFalseConditions array";
assert result5 == false : "testFalseConditions query";
assert result6 == false : "testFalseConditions date";
assert result7 == false : "testFalseConditions true";
assert result8 == false : "testFalseConditions float";
