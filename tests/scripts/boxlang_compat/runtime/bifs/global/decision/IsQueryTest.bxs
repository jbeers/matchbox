// SKIPPED [boxlang_compat] (JVM-only, hard requirement): testOnCreateObject
// instantiates the internal Java Query class; the BoxLang query path runs below.

// testOnQueryNew
assert isQuery( queryNew( "id,name", "numeric,varchar" ) ) : "testOnQueryNew";

// testFalseConditions
aBool = isQuery( true );
aStruct = isQuery( { columns: ["id", "name"] } );
assert aBool == false : "testFalseConditions bool";
assert aStruct == false : "testFalseConditions struct";
