// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/bifs/global/decision/IsClosureTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// testTrueConditions
closure = isClosure( function() {} );
arrowFunction = isClosure( () => {} );
myFunc = function() {};
functionReference = isClosure( myFunc );
assert closure : "testTrueConditions closure";
assert arrowFunction : "testTrueConditions arrow";
assert functionReference : "testTrueConditions function-reference";

// testFalseConditions
anInteger = isClosure( 123 );
aString = isClosure( "abc" );
assert anInteger == false : "testFalseConditions integer";
assert aString == false : "testFalseConditions string";
