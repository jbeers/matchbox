// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/bifs/global/decision/IsLocalhostTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// testTrueConditions
localhost = isLocalHost( "localhost" );
ipv4loopback = isLocalHost( "127.0.0.1" );
ipv6loopback = isLocalHost( "::1" );
assert localhost : "testTrueConditions localhost";
assert ipv4loopback : "testTrueConditions ipv4";
assert ipv6loopback : "testTrueConditions ipv6";

// testFalseConditions
empty = isLocalHost( "" );
assert empty == false : "testFalseConditions empty";

// testThrow
threw = false;
try {
    x = isLocalHost( {} );
} catch ( e ) {
    threw = true;
}
assert threw : "testThrow";
