// boxlang_compat: ortus/boxlang/runtime/bifs/global/decision/IsRangeTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// SKIPPED [boxlang_compat] (JVM-only, hard requirement): the omitted cases
// drive the internal Java IsRange API directly.

// testIsRangeBIFWithRangeLiteral
result = isRange( 1..5 );
assert result : "testIsRangeBIFWithRangeLiteral";

// testIsRangeBIFWithNonRangeLiteral
result = isRange( [ 1, 2, 3 ] );
assert result == false : "testIsRangeBIFWithNonRangeLiteral";
