// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/bifs/global/conversion/ToUnmodifiableTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// testBif
result = toUnmodifiable( [ 1, 2, 3 ] );
assert isArray( result ) : "testBif array";
result = toUnmodifiable( { a: 1, b: 2, c: 3 } );
assert isStruct( result ) : "testBif struct";

// testMemberFunction
result2 = [1,2,3].toUnmodifiable();
assert isArray( result2 ) : "testMemberFunction array";
result2 = { a: 1, b: 2, c: 3 }.toUnmodifiable();
assert isStruct( result2 ) : "testMemberFunction struct";
