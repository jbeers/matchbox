// boxlang_compat: ortus/boxlang/runtime/bifs/global/array/ArrayChunkTest.java
data = [1,2,3,4,5,6,7,8,9];
r = arrayChunk( data, 3 );
assert arrayLen( r ) == 3 : "testChunk size";
assert arrayLen( r[1] ) == 3 : "testChunk first-size";
assert r[1][1] == 1 : "testChunk value";
threw = false;
try {
    arrayChunk( [1,2,3], 0 );
} catch ( any e ) {
    threw = true;
}
assert threw : "testChunk zero-error";
threw = false;
try {
    arrayChunk( [1,2,3], -1 );
} catch ( any e ) {
    threw = true;
}
assert threw : "testChunk negative-error";
