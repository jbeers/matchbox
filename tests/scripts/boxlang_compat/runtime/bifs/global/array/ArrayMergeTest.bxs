// boxlang_compat: ortus/boxlang/runtime/bifs/global/array/ArrayMergeTest.java
r = arrayMerge( [1,2], [3,4] );
assert arrayLen( r ) == 4 : "testMerge size";
assert r[1] == 1 : "testMerge 1";
assert r[3] == 3 : "testMerge 3";
a = [1,2];
b = [3,4];
r = arrayMerge( a, b, true );
assert arrayLen( r ) == 4 : "testMerge-new size";
