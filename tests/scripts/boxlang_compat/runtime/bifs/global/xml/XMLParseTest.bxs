// testCanParse
result = xmlParse( '<root><brad name="wood" /></root>' );
assert isXML( result ) : "testCanParse result-type";

// testCanParseFromFile
// SKIPPED [boxlang_compat] (JVM-only, hard requirement): the JVM test uses
