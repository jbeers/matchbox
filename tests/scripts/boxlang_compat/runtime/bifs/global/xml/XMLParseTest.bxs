// testCanParseWithInaccessibleDTD
result = xmlParse( '<!DOCTYPE root SYSTEM "http://www.mach-ii.com/dtds/mach-ii_1_9_0.dtd"><root><brad name="wood" /></root>' );
assert isXML( result ) : "testCanParseWithInaccessibleDTD result-type";
