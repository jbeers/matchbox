// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/bifs/global/xml/XMLSearchTest.java
// ---------------------------------------------------------------------------

// testCanSearch
xml = xmlParse( '<users><user name="brad" /><user name="luis" /></users>' );
result = xmlSearch( xml, "/users/user" );
assert isArray( result ) : "testCanSearch result-type";
assert result.len() == 2 : "testCanSearch size";
assert result[1].xmlAttributes.name == "brad" : "testCanSearch first-name";
assert result[2].xmlAttributes.name == "luis" : "testCanSearch second-name";

// testCanSearchParams
xml = xmlParse( '<users><user name="brad" /><user name="luis" /></users>' );
result = xmlSearch( xml, "/users/user[@name=$param1]", { param1: "brad" } );
assert isArray( result ) : "testCanSearchParams result-type";
assert result.len() == 1 : "testCanSearchParams size";
assert result[1].xmlAttributes.name == "brad" : "testCanSearchParams name";

// testCanSearchMember
xml = xmlParse( '<users><user name="brad" /><user name="luis" /></users>' );
result = xml.search( "/users/user" );
assert isArray( result ) : "testCanSearchMember result-type";
assert result.len() == 2 : "testCanSearchMember size";
assert result[1].xmlAttributes.name == "brad" : "testCanSearchMember first-name";
assert result[2].xmlAttributes.name == "luis" : "testCanSearchMember second-name";

// testCanSearchString
xml = '<Conditions NotBefore="2018-08-24T10:54:19.464Z" NotOnOrAfter="2018-08-24T11:54:19.464Z"></Conditions>';
result = xmlSearch( xml, "string(/Conditions/@NotBefore)" );
assert isString( result ) : "testCanSearchString result-type";
assert result == "2018-08-24T10:54:19.464Z" : "testCanSearchString result";

// testCanSearchBoolean
xml = '<Conditions IsActive="true"></Conditions>';
result = xmlSearch( xml, "boolean(/Conditions/@IsActive)" );
assert isBoolean( result ) : "testCanSearchBoolean result-type";
assert result == true : "testCanSearchBoolean result";

// testCanSearchNumeric
xml = '<Item Price="19.99"></Item>';
result = xmlSearch( xml, "number(/Item/@Price)" );
assert result == 19.99 : "testCanSearchNumeric result";

// testNamespaceSearching
xmlObj = xmlParse( '<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><SOAP-ENV:Header><ns1:MessageHeader xmlns:ns1="http://www.ebxml.org/namespaces/messageHeader"><ns1:From><ns1:PartyId ns1:type="urn:x12.org:IO5:01">Ortus Solutions</ns1:PartyId></ns1:From><ns1:Action>Testing</ns1:Action></ns1:MessageHeader></SOAP-ENV:Header></SOAP-ENV:Envelope>' );
result = xmlSearch( xmlObj.xmlRoot, ".//SOAP-ENV:Header" );
assert isArray( result ) : "testNamespaceSearching result-type";
assert result.len() == 1 : "testNamespaceSearching size";

