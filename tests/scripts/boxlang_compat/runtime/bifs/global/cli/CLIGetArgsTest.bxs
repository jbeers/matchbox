// boxlang_compat: ortus/boxlang/runtime/bifs/global/cli/CLIGetArgsTest.java

// testEmpty
result = CLIGetArgs();
assert isStruct( result ) : "testEmpty struct";
assert structCount( result ) == 2 : "testEmpty size";
assert structCount( result.options ) == 0 : "testEmpty options";
assert arrayLen( result.positionals ) == 0 : "testEmpty positionals";

