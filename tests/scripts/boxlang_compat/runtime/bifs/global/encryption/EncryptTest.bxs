// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/bifs/global/encryption/EncryptTest.java
// ---------------------------------------------------------------------------

// testBif
key = generateSecretKey();
result = encrypt( "foo", key );
assert isString( result ) : "testBif default type";
decrypted = decrypt( result, key );
assert decrypted == "foo" : "testBif default value";

key = generateSecretKey( "AES", 256 );
iv = "e+T6cmQfzqMpO2oUeboGYw==";
result = encrypt( "foo", key, "AES/CBC/PKCS5Padding", "Base64", binaryDecode( iv, "base64" ), 2000 );
assert isString( result ) : "testBif AES CBC type";
decrypted = decrypt( result, key, "AES/CBC/PKCS5Padding", "Base64", binaryDecode( iv, "base64" ), 2000 );
assert decrypted == "foo" : "testBif AES CBC value";

key = generateSecretKey( "AES", 256 );
iv = "e+T6cmQfzqMpO2oUeboGYw==";
result = encrypt( "foo", key, "AES/ECB/PKCS5Padding", "UU", binaryDecode( iv, "base64" ), 2000 );
assert isString( result ) : "testBif AES ECB type";
decrypted = decrypt( result, key, "AES/ECB/PKCS5Padding", "UU", binaryDecode( iv, "base64" ), 2000 );
assert decrypted == "foo" : "testBif AES ECB value";

key = generateSecretKey( "DESede" );
iv = generateSecretKey( "DESede" );
result = encrypt( "foo", key, "DESede/ECB/PKCS5Padding", "UU", binaryDecode( iv, "base64" ), 2000 );
assert isString( result ) : "testBif DESede type";
decrypted = decrypt( result, key, "DESede/ECB/PKCS5Padding", "UU", binaryDecode( iv, "base64" ), 2000 );
assert decrypted == "foo" : "testBif DESede value";

key = generateSecretKey( "Blowfish" );
result = encrypt( "foo", key, "Blowfish", "UU", "foo", 2000 );
assert isString( result ) : "testBif Blowfish type";
decrypted = decrypt( result, key, "Blowfish", "UU", "foo", 2000 );
assert decrypted == "foo" : "testBif Blowfish value";

// testCompat
key = "oeY9XnYhS4ERqBeMDkcmVw==";
iv = "e+T6cmQfzqMpO2oUeboGYw==";
result = encrypt( "foobar", key, "AES/CBC/PKCS5Padding", "base64", binaryDecode( iv, "base64" ) );
assert isString( result ) : "testCompat fixed type";
assert result == "G4w/e9u0DUM+jQTOoxC/nA==" : "testCompat fixed value";

key = "oeY9XnYhS4ERqBeMDkcmVw==";
iv = "e+T6cmQfzqMpO2oUeboGYw==";
result = encrypt( "foobar", key, "AES/CBC/PKCS5Padding", "base64" );
decrypted = decrypt( result, key, "AES/CBC/PKCS5Padding", "base64", null, 1000 );
assert decrypted == "foobar" : "testCompat generated-IV value";

// testSaltValues
key = "oeY9XnYhS4ERqBeMDkcmVw==";
salt = "foo";
result = encrypt( "foobar", key, "AES", "base64", salt );
assert isString( result ) : "testSaltValues AES type";
assert result == "FE54Rn9W0YoZteRe1aV1qg==" : "testSaltValues AES value";

key = "oeY9XnYhS4ERqBeMDkcmVw==";
salt = "foo";
result = encrypt( "foobar", key, "AES/CBC/PKCS5Padding", "base64", salt );
assert isString( result ) : "testSaltValues AES CBC type";
assert result == "mE7BeU2ljKYNWkbKKwqkIA==" : "testSaltValues AES CBC value";

// testRSAEncryptionWithPrivateKey
// PKCS#8 format RSA private key Base64 encoded (no PEM headers, single line)
privateKey = "";

result = encrypt( "foo", privateKey, "RSA" );
assert isString( result ) : "testRSAEncryptionWithPrivateKey type";
assert len( result ) > 0 : "testRSAEncryptionWithPrivateKey value";

// testStringCasting
key = "c9vej1bOi6UgMTjySjbfa/+11JTKD1XTv0RRVLPvolk=";
val = 8071.4;
result = encrypt( val, key, "AES", "base64" );
decryptResult = decrypt( result, key, "AES", "base64" );
assert isString( result ) : "testStringCasting numeric type";
assert result == "vviySHgFVwMXVkF1AkZOhw==" : "testStringCasting numeric value";
assert isString( decryptResult ) : "testStringCasting numeric decrypt type";

key = "c9vej1bOi6UgMTjySjbfa/+11JTKD1XTv0RRVLPvolk=";
val = parseDateTime( "2024-01-01T12:00:00Z" );
result = encrypt( val, key, "AES", "base64" );
decryptResult = decrypt( result, key, "AES", "base64" );
assert isString( result ) : "testStringCasting date type";
assert result == "7McNhhpjuNaXuJ2hpZFnTEy1ZTlxdy7hsa6Gp70VYaE=" : "testStringCasting date value";
assert isString( decryptResult ) : "testStringCasting date decrypt type";

key = "c9vej1bOi6UgMTjySjbfa/+11JTKD1XTv0RRVLPvolk=";
val = true;
result = encrypt( val, key, "AES", "base64" );
decryptResult = decrypt( result, key, "AES", "base64" );
assert isString( result ) : "testStringCasting boolean type";
assert result == "bv/vjxtYutOqVNCijv7EAQ==" : "testStringCasting boolean value";
assert isString( decryptResult ) : "testStringCasting boolean decrypt type";
