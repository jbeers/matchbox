// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/bifs/global/encryption/DecryptTest.java
// ---------------------------------------------------------------------------

// testBif
key = generateSecretKey();
encrypted = encrypt( "foo", key );
result = decrypt( encrypted, key );
assert isString( result ) : "testBif default type";
assert result == "foo" : "testBif default value";

key = generateSecretKey( "Blowfish" );
encrypted = encrypt( "foo", key, "Blowfish", "Hex" );
result = decrypt( encrypted, key, "Blowfish", "Hex" );
assert isString( result ) : "testBif Blowfish type";
assert result == "foo" : "testBif Blowfish value";

key = generateSecretKey( "AES" );
encrypted = encrypt( "foo", key, "AES/ECB/PKCS5Padding", "Hex" );
result = decrypt( encrypted, key, "AES/ECB/PKCS5Padding", "Hex" );
assert isString( result ) : "testBif AES type";
assert result == "foo" : "testBif AES value";

key = generateSecretKey( "DESede" );
encrypted = encrypt( "foo", key, "DESede/ECB/PKCS5Padding", "Hex" );
result = decrypt( encrypted, key, "DESede/ECB/PKCS5Padding", "Hex" );
assert isString( result ) : "testBif DESede type";
assert result == "foo" : "testBif DESede value";

// testSaltValues
key = "oeY9XnYhS4ERqBeMDkcmVw==";
salt = "foo";
result = decrypt( "FE54Rn9W0YoZteRe1aV1qg==", key, "AES", "base64", salt );
assert isString( result ) : "testSaltValues AES type";
assert result == "foobar" : "testSaltValues AES value";

key = "oeY9XnYhS4ERqBeMDkcmVw==";
salt = "foo";
result = decrypt( "mE7BeU2ljKYNWkbKKwqkIA==", key, "AES/CBC/PKCS5Padding", "base64", salt );
assert isString( result ) : "testSaltValues AES CBC type";
assert result == "foobar" : "testSaltValues AES CBC value";

// testRSADecryptionWithPrivateKey
// PKCS#8 format RSA private key Base64 encoded (no PEM headers, single line)
privateKey = "";
// X509 format RSA public key Base64 encoded (corresponding to the private key above)
publicKey = "";

encrypted = encrypt( "foo", privateKey, "RSA" );
result = decrypt( encrypted, publicKey, "RSA" );
assert isString( result ) : "testRSADecryptionWithPrivateKey type";
assert result == "foo" : "testRSADecryptionWithPrivateKey value";

// testObjectDecryption
key = generateSecretKey();
encrypted = encrypt( { foo: "bar" }, key );
result = decrypt( encrypted, key );
assert isStruct( result ) : "testObjectDecryption type";
assert result.foo == "bar" : "testObjectDecryption value";
