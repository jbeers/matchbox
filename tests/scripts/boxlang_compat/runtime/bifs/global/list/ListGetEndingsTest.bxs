// boxlang_compat: ortus/boxlang/runtime/bifs/global/list/ListGetEndingsTest.java
// The JVM transfer exercises the listFirst/listLast endpoints in this test.
list = "a,b,c";
assert listFirst( list ) == "a" : "testListFirst";
assert list.listFirst() == "a" : "testListFirstMember";
assert listLast( list ) == "c" : "testListLast";
assert list.listLast() == "c" : "testListLastMember";

