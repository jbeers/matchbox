// testMultipleResultSets
// The JVM test is @Disabled because the behavior is not implemented there;
// it remains active here so a MatchBox behavior gap is red rather than hidden.
resetDevelopers();
result = queryExecute( "SELECT * FROM developers WHERE id = 1; SELECT * FROM developers WHERE id = 77;" );
assert result.recordCount == 1 : "testMultipleResultSets count";
assert result.name[1] == "Luis Majano" : "testMultipleResultSets first result";

// testObjectMarshallingOfExecutedQuery
// SKIPPED [boxlang_compat] (JVM-only, hard requirement): the JVM test directly
// constructs ExecutedQuery and invokes the Java ObjectMarshaller API.

// testTransformerClosure
resetDevelopers();
result = queryExecute(
    "SELECT id, name, role FROM developers ORDER BY id",
    [],
    { transformer: ( query, metadata ) => {
        return {
            count: query.recordCount,
            columns: query.getColumnNames(),
            data: query.toArrayOfStructs()
        };
    } }
);
assert isStruct( result ) : "testTransformerClosure struct";
assert result.count == 4 : "testTransformerClosure count";
assert isArray( result.columns ) : "testTransformerClosure columns";
assert isArray( result.data ) : "testTransformerClosure data";
assert len( result.data ) == 4 : "testTransformerClosure rows";

// testTransformerClassInstance
class TestTransformer {
    function transform( query, metadata ) {
        return {
            total: query.recordCount,
            firstRow: query.getRowAsStruct( 0 )
        };
    }
}
transformer = new TestTransformer();
result = queryExecute( "SELECT id, name FROM developers ORDER BY id", [], { transformer: transformer } );
assert isStruct( result ) : "testTransformerClassInstance struct";
assert result.total == 4 : "testTransformerClassInstance total";
assert isStruct( result.firstRow ) : "testTransformerClassInstance first row";
assert result.firstRow.id == 1 : "testTransformerClassInstance id";
assert result.firstRow.name == "Luis Majano" : "testTransformerClassInstance name";

// testTransformerRegisteredName
result = queryExecute(
    "SELECT id, name FROM developers",
    [],
    { transformer: ( query, metadata ) => {
        return { rows: query.recordCount, cols: query.getColumnList() };
    } }
);
assert isStruct( result ) : "testTransformerRegisteredName struct";
assert result.rows == 4 : "testTransformerRegisteredName rows";
assert result.cols == "ID,NAME" : "testTransformerRegisteredName columns";

// testTransformerNameNotFound
threw = false;
try {
    result = queryExecute( "SELECT id FROM developers", [], { transformer: "nonexistent" } );
} catch ( e ) {
    threw = true;
    assert e.message contains "Query transformer 'nonexistent' not found" : "testTransformerNameNotFound message";
}
assert threw : "testTransformerNameNotFound throws";

// testTransformerNamed
