assert threw : "testAdHocDataSource throws";

// testMaxRows
resetDevelopers();
result = queryExecute( "SELECT * FROM developers", {}, { maxrows: 1 } );
assert isQuery( result ) : "testMaxRows query";
assert result.recordCount == 1 : "testMaxRows count";

// testDeleteQueryResult
resetDevelopers();
result = queryExecute(
    "DELETE FROM developers WHERE id = :id",
    { id: 1 },
    { result: "queryResults" }
);
assert isQuery( result ) : "testDeleteQueryResult query";
assert queryResults.recordCount == 1 : "testDeleteQueryResult recordCount";

// testConnectionClose
// SKIPPED [boxlang_compat] (JVM-only, hard requirement): pool active-connection
// counters are internal Java datasource state, but the query remains active.
resetDevelopers();
result = queryExecute( "SELECT * FROM developers", {}, { maxrows: 1 } );
assert isQuery( result ) : "testConnectionClose query";

// testSQLDate
resetDevelopers();
result = queryExecute( "SELECT CURRENT_DATE as my_date" );
isDate = isNumeric( result.my_date[1] );
assert isDate == false : "testSQLDate";

// testSQLTime
resetDevelopers();
result = queryExecute( "SELECT CURRENT_TIMESTAMP as my_date" );
isDate = isNumeric( result.my_date[1] );
assert isDate == false : "testSQLTime";

// testQueryCaching
resetDevelopers();
sql = "SELECT id,name,role FROM developers WHERE role = ?";
params = [ "Developer" ];
result = queryExecute( sql, params, { cache: true, cacheTimeout: createTimespan( 0, 0, 0, 2 ), result: "queryMeta", returnType: "array" } );
assert queryMeta.cached == false : "testQueryCaching first cached";
result2 = queryExecute( sql, params, { cache: true, cacheTimeout: createTimespan( 0, 0, 0, 2 ), result: "queryMeta2", returnType: "array" } );
assert queryMeta2.cached == true : "testQueryCaching second cached";
result3 = queryExecute( sql, [ "Admin" ], { cache: true, cacheTimeout: createTimespan( 0, 0, 0, 2 ), result: "queryMeta3", returnType: "array" } );
assert queryMeta3.cached == false : "testQueryCaching different params";
result4 = queryExecute( sql, params, { cache: false, cacheTimeout: createTimespan( 0, 0, 0, 2 ), result: "queryMeta4", returnType: "array" } );
assert queryMeta4.cached == false : "testQueryCaching disabled";
assert result == result2 : "testQueryCaching first equals second";
assert result2 == result4 : "testQueryCaching second equals fourth";
assert result != result3 : "testQueryCaching different result";

// testCustomCacheProvider
resetDevelopers();
result = queryExecute(
    "SELECT id,name,role FROM developers WHERE role = ?",
    [ "Developer" ],
    { cache: true, cacheProvider: "default", result: "queryMeta", returnType: "array" }
);
assert queryMeta.cached == false : "testCustomCacheProvider first";
result2 = queryExecute(
    "SELECT id,name,role FROM developers WHERE role = ?",
    [ "Developer" ],
    { cache: true, cacheProvider: "default", result: "queryMeta2", returnType: "array" }
);
assert result == result2 : "testCustomCacheProvider results";
assert queryMeta2.cached == true : "testCustomCacheProvider second";

// testCacheResultMeta
resetDevelopers();
result = queryExecute(
    "SELECT * FROM developers WHERE role = ?",
    [ "Admin" ],
    {
        cache: true,
        cacheProvider: "default",
        cacheKey: "adminDevs",
        cacheTimeout: createTimespan( 0, 1, 0, 0 ),
        cacheLastAccessTimeout: createTimespan( 0, 0, 30, 0 ),
        result: "queryMeta"
    }
);
result2 = queryExecute(
    "SELECT * FROM developers WHERE role = ?",
    [ "Admin" ],
    {
        cache: true,
        cacheProvider: "default",
        cacheKey: "adminDevs",
        cacheTimeout: createTimespan( 0, 1, 0, 0 ),
        cacheLastAccessTimeout: createTimespan( 0, 0, 30, 0 ),
        result: "queryMeta2"
    }
);
assert queryMeta.cached == false : "testCacheResultMeta first";
assert queryMeta2.cached == true : "testCacheResultMeta second";
assert queryMeta2.keyExists( "cached" ) : "testCacheResultMeta cached key";
assert queryMeta2.keyExists( "cacheProvider" ) : "testCacheResultMeta provider key";
assert queryMeta2.keyExists( "cacheKey" ) : "testCacheResultMeta key key";
assert queryMeta2.keyExists( "cacheTimeout" ) : "testCacheResultMeta timeout key";
assert queryMeta2.keyExists( "cacheLastAccessTimeout" ) : "testCacheResultMeta last access key";
assert queryMeta2.cacheProvider == "default" : "testCacheResultMeta provider";
assert queryMeta2.cacheKey == "adminDevs" : "testCacheResultMeta key";
assert queryMeta2.cacheTimeout == createTimespan( 0, 1, 0, 0 ) : "testCacheResultMeta timeout";
assert queryMeta2.cacheLastAccessTimeout == createTimespan( 0, 0, 30, 0 ) : "testCacheResultMeta last access";

// testZeroCacheTimeout
resetDevelopers();
sql = "SELECT id,name,role FROM developers WHERE role = ?";
params = [ "Developer" ];
result = queryExecute( sql, params, { cache: true, cacheTimeout: createTimespan( 0, 0, 0, 0 ), result: "queryMeta", returnType: "array" } );
assert queryMeta.cached == false : "testZeroCacheTimeout first";
result2 = queryExecute( sql, params, { cache: true, cacheTimeout: createTimespan( 0, 0, 0, 0 ), result: "queryMeta2", returnType: "array" } );
assert queryMeta2.cached == true : "testZeroCacheTimeout second";
assert result == result2 : "testZeroCacheTimeout results";

// testNegativeCacheTimeout
resetDevelopers();
sql = "SELECT id,name,role FROM developers WHERE role = ?";
params = [ "Developer" ];
queryExecute( sql, params, { cache: true, cacheTimeout: createTimespan( 0, 0, 0, -1 ), result: "queryMeta", returnType: "array" } );
result = queryMeta;
assert result.cached == false : "testNegativeCacheTimeout";

// testNegativeCacheTimeoutClearsCache
resetDevelopers();
result = queryExecute( "SELECT CURRENT_TIMESTAMP as timestamp FROM developers", [], { cache: true, cacheTimeout: createTimespan( 0, 0, 0, 1 ), result: "queryMeta" } );
result2 = queryExecute( "SELECT CURRENT_TIMESTAMP as timestamp FROM developers", [], { cache: true, cacheTimeout: createTimespan( 0, 0, 0, 1 ), result: "queryMeta2" } );
result3 = queryExecute( "SELECT CURRENT_TIMESTAMP as timestamp FROM developers", [], { cache: true, cacheTimeout: createTimespan( 0, 0, 0, 0 ), result: "zeroTimeoutQueryMeta" } );
result4 = queryExecute( "SELECT CURRENT_TIMESTAMP as timestamp FROM developers", [], { cache: true, cacheTimeout: createTimespan( 0, 0, 0, -1 ), result: "negativeTimeoutQueryMeta" } );
result5 = queryExecute( "SELECT CURRENT_TIMESTAMP as timestamp FROM developers", [], { cache: true, cacheTimeout: createTimespan( 0, 0, 0, 1 ), result: "queryMeta5" } );
result6 = queryExecute( "SELECT CURRENT_TIMESTAMP as timestamp FROM developers", [], { cache: true, cacheTimeout: createTimespan( 0, 0, 0, 1 ), result: "queryMeta6" } );
assert queryMeta.cached == false : "testNegativeCacheTimeoutClearsCache first";
assert queryMeta2.cached == true : "testNegativeCacheTimeoutClearsCache second";
assert result2.timestamp[1] == result.timestamp[1] : "testNegativeCacheTimeoutClearsCache second value";
assert queryMeta3.cached == true : "testNegativeCacheTimeoutClearsCache zero timeout";
assert result3.timestamp[1] == result2.timestamp[1] : "testNegativeCacheTimeoutClearsCache zero value";
assert result3.timestamp[1] == result.timestamp[1] : "testNegativeCacheTimeoutClearsCache initial value";
assert queryMeta4.cached == false : "testNegativeCacheTimeoutClearsCache negative";
assert queryMeta5.cached == false : "testNegativeCacheTimeoutClearsCache after clear";
assert queryMeta6.cached == true : "testNegativeCacheTimeoutClearsCache final";
assert result6.timestamp[1] == result5.timestamp[1] : "testNegativeCacheTimeoutClearsCache final value";

// testDuplicateColumnResultSets
resetDevelopers();
result = queryExecute( "SELECT name, CURRENT_DATE AS name, id, role FROM developers WHERE id=1" );
assert isQuery( result ) : "testDuplicateColumnResultSets query";
assert result.recordCount == 1 : "testDuplicateColumnResultSets count";
assert result.name[1] == "Luis Majano" : "testDuplicateColumnResultSets name";
assert result.id[1] == 1 : "testDuplicateColumnResultSets id";
assert result.role[1] == "CEO" : "testDuplicateColumnResultSets role";

// testDifferentConnectionManagerPerThread
