// testMissingNamedDataSource
resetDevelopers();
threw = false;
try {
    result = queryExecute(
        "SELECT * FROM developers WHERE name = :name",
        { name: "Michael Born" },
        { datasource: "not_found" }
    );
} catch ( e ) {
    threw = true;
    assert e.message contains "Datasource with name [not_found] not found" : "testMissingNamedDataSource message";
}
assert threw : "testMissingNamedDataSource throws";
assert result == null : "testMissingNamedDataSource result";

// testReturnTypeArray
resetDevelopers();
result = queryExecute( "SELECT * FROM developers ORDER BY id", [], { returntype: "array" } );
assert isArray( result ) : "testReturnTypeArray array";
assert len( result ) == 4 : "testReturnTypeArray count";
assert isStruct( result[1] ) : "testReturnTypeArray Luis struct";
assert result[1].id == 1 : "testReturnTypeArray Luis id";
assert result[1].name == "Luis Majano" : "testReturnTypeArray Luis name";
assert result[1].role == "CEO" : "testReturnTypeArray Luis role";
assert isStruct( result[2] ) : "testReturnTypeArray Eric struct";
assert result[2].id == 42 : "testReturnTypeArray Eric id";
assert result[2].name == "Eric Peterson" : "testReturnTypeArray Eric name";
assert result[2].role == "Developer" : "testReturnTypeArray Eric role";
assert isStruct( result[3] ) : "testReturnTypeArray Michael struct";
assert result[3].id == 77 : "testReturnTypeArray Michael id";
assert result[3].name == "Michael Born" : "testReturnTypeArray Michael name";
assert result[3].role == "Developer" : "testReturnTypeArray Michael role";

// testReturnTypeStruct
resetDevelopers();
result = queryExecute(
    "SELECT * FROM developers ORDER BY id",
    [],
    { returntype: "struct", columnKey: "role" }
);
assert isStruct( result ) : "testReturnTypeStruct struct";
assert len( result ) == 3 : "testReturnTypeStruct key count";
assert isArray( result.CEO ) : "testReturnTypeStruct CEO array";
assert len( result.CEO ) == 1 : "testReturnTypeStruct CEO count";
assert result.CEO[1].id == 1 : "testReturnTypeStruct CEO id";
assert result.CEO[1].name == "Luis Majano" : "testReturnTypeStruct CEO name";
assert isArray( result.Developer ) : "testReturnTypeStruct Developer array";
assert len( result.Developer ) == 2 : "testReturnTypeStruct Developer count";
assert result.Developer[1].id == 42 : "testReturnTypeStruct Eric id";
assert result.Developer[1].name == "Eric Peterson" : "testReturnTypeStruct Eric name";
assert result.Developer[2].id == 77 : "testReturnTypeStruct Michael id";
assert result.Developer[2].name == "Michael Born" : "testReturnTypeStruct Michael name";

// testMissingColumnKey
threw = false;
try {
    result = queryExecute( "SELECT * FROM developers ORDER BY id", [], { returnType: "struct" } );
} catch ( e ) {
    threw = true;
    assert e.message == "You must define a `columnKey` option when using `returnType: struct`." : "testMissingColumnKey message";
}
assert threw : "testMissingColumnKey throws";
assert result == null : "testMissingColumnKey result";

// testInvalidReturnType
threw = false;
try {
    result = queryExecute( "SELECT * FROM developers ORDER BY id", [], { returnType: "foobar" } );
} catch ( e ) {
    threw = true;
    assert e.message == "Unknown return type: foobar" : "testInvalidReturnType message";
}
assert threw : "testInvalidReturnType throws";
assert result == null : "testInvalidReturnType result";

// testResultVariable
resetDevelopers();
result = queryExecute(
    "SELECT * FROM developers WHERE role = ?",
    [ "Developer" ],
    { result: "queryResults" }
);
meta = queryResults;
assert isStruct( meta ) : "testResultVariable struct";
assert meta.keyExists( "sql" ) : "testResultVariable sql key";
assert meta.sql == "SELECT * FROM developers WHERE role = 'Developer'" : "testResultVariable sql";
assert meta.keyExists( "sqlParameters" ) : "testResultVariable parameters key";
assert meta.sqlParameters[1] == "Developer" : "testResultVariable parameter";
assert meta.keyExists( "recordCount" ) : "testResultVariable recordCount key";
assert meta.recordCount == 2 : "testResultVariable recordCount";
assert meta.keyExists( "columnList" ) : "testResultVariable columnList key";
assert meta.columnList == "ID,NAME,ROLE,CREATEDAT" : "testResultVariable columnList";
assert meta.keyExists( "executionTime" ) : "testResultVariable executionTime key";
assert meta.executionTime >= 0 : "testResultVariable executionTime";
assert meta.keyExists( "generatedKey" ) == false : "testResultVariable generatedKey";

