// testTransformerPrecedence
result = queryExecute(
    "SELECT id, name FROM developers ORDER BY id",
    [],
    { returnType: "array", transformer: ( query, metadata ) => "transformer wins" }
);
assert result == "transformer wins" : "testTransformerPrecedence";

// testTransformerReceivesMetadata
result = queryExecute(
    "SELECT id, name FROM developers WHERE id = ?",
    [ 1 ],
    {
        result: "queryMeta",
        transformer: ( query, metadata ) => {
            return {
                hasSql: metadata.keyExists( "sql" ),
                hasRecordCount: metadata.keyExists( "recordCount" ),
                hasColumnList: metadata.keyExists( "columnList" )
            };
        }
    }
);
assert isStruct( result ) : "testTransformerReceivesMetadata struct";
assert result.hasSql == true : "testTransformerReceivesMetadata sql";
assert result.hasRecordCount == true : "testTransformerReceivesMetadata recordCount";
assert result.hasColumnList == true : "testTransformerReceivesMetadata columnList";

// testTransformerReturnsAnyType
result1 = queryExecute( "SELECT id FROM developers", [], { transformer: ( q, m ) => "string result" } );
assert result1 == "string result" : "testTransformerReturnsAnyType string";
result2 = queryExecute( "SELECT id FROM developers", [], { transformer: ( q, m ) => 42 } );
assert result2 == 42 : "testTransformerReturnsAnyType number";
result3 = queryExecute( "SELECT id FROM developers", [], { transformer: ( q, m ) => [ 1, 2, 3 ] } );
assert isArray( result3 ) : "testTransformerReturnsAnyType array";

// testTransformerJDBCMetadata
result = queryExecute(
    "SELECT id, name, role FROM developers ORDER BY id",
    [],
    { transformer: ( query, metadata ) => {
        colMeta = query.getColumnMeta();
        return {
            idNullable: colMeta.id.nullable,
            idReadOnly: colMeta.id.readOnly,
            nameMaxLength: colMeta.name.maxLength,
            hasDecimals: colMeta.id.keyExists( "decimals" )
        };
    } }
);
assert isStruct( result ) : "testTransformerJDBCMetadata struct";
assert result.keyExists( "idNullable" ) : "testTransformerJDBCMetadata nullable";
assert result.keyExists( "idReadOnly" ) : "testTransformerJDBCMetadata readOnly";
assert result.keyExists( "nameMaxLength" ) : "testTransformerJDBCMetadata maxLength";
assert result.keyExists( "hasDecimals" ) : "testTransformerJDBCMetadata decimals";

// testTransformerTabularFormat
result = queryExecute(
    "SELECT id, name FROM developers ORDER BY id",
    [],
    { transformer: ( query, metadata ) => {
        data = [];
        for ( var i = 1; i <= query.recordCount; i++ ) {
            data.append( [ query.id[i], query.name[i] ] );
        }
        return { columns: query.getColumnNames(), data: data };
    } }
);
assert isStruct( result ) : "testTransformerTabularFormat struct";
assert len( result.columns ) == 2 : "testTransformerTabularFormat columns count";
assert result.columns[1] == "ID" : "testTransformerTabularFormat first column";
assert result.columns[2] == "NAME" : "testTransformerTabularFormat second column";
assert len( result.data ) == 4 : "testTransformerTabularFormat data count";
assert result.data[1][1] == 1 : "testTransformerTabularFormat first id";
assert result.data[1][2] == "Luis Majano" : "testTransformerTabularFormat first name";

// testTransformerRichFormat
result = queryExecute(
    "SELECT id, name FROM developers ORDER BY id",
    [],
    { transformer: ( query, metadata ) => {
        colMeta = query.getColumnMeta();
        columns = [];
        for ( var colName in query.getColumnNames() ) {
            info = colMeta[colName];
            columns.append( {
                name: colName,
                type: info.type,
                nullable: info.nullable,
                readOnly: info.readOnly,
                decimals: info.decimals,
                maxLength: info.maxLength
            } );
        }
        data = [];
        for ( var i = 1; i <= query.recordCount; i++ ) {
            data.append( [ query.id[i], query.name[i] ] );
        }
        return { count: query.recordCount, columns: columns, data: data };
    } }
);
assert isStruct( result ) : "testTransformerRichFormat struct";
assert result.count == 4 : "testTransformerRichFormat count";
assert len( result.columns ) == 2 : "testTransformerRichFormat columns";
assert result.columns[1].name == "ID" : "testTransformerRichFormat id name";
assert result.columns[1].keyExists( "type" ) : "testTransformerRichFormat type";
assert result.columns[1].keyExists( "nullable" ) : "testTransformerRichFormat nullable";
assert result.columns[1].keyExists( "readOnly" ) : "testTransformerRichFormat readOnly";
assert len( result.data ) == 4 : "testTransformerRichFormat data";

// testTransformerEmptyResultSet
result = queryExecute(
    "SELECT id, name FROM developers WHERE id = 99999",
    [],
    { transformer: ( query, metadata ) => {
        return { count: query.recordCount, isEmpty: query.recordCount == 0 };
    } }
);
assert isStruct( result ) : "testTransformerEmptyResultSet struct";
assert result.count == 0 : "testTransformerEmptyResultSet count";
assert result.isEmpty == true : "testTransformerEmptyResultSet empty";

// testTransformerThrowsError
threw = false;
try {
    result = queryExecute(
        "SELECT id FROM developers",
        [],
        { transformer: ( query, metadata ) => { throw( "Custom transformer error" ); } }
    );
} catch ( e ) {
    threw = true;
    assert e.message contains "Custom transformer error" : "testTransformerThrowsError message";
}
assert threw : "testTransformerThrowsError throws";

// testTransformerClosureScope
prefix = "DEV-";
result = queryExecute(
    "SELECT id, name FROM developers ORDER BY id",
    [],
    { transformer: ( query, metadata ) => {
        return query.toArrayOfStructs().map( row => {
            row.displayName = prefix & row.name;
            return row;
        } );
    } }
);
assert isArray( result ) : "testTransformerClosureScope array";
assert result[1].displayName == "DEV-Luis Majano" : "testTransformerClosureScope name";

// testTransformerClassInstanceVariables
class PrefixTransformer {
    variables.prefix = "USER-";
    function transform( query, metadata ) {
        return query.toArrayOfStructs().map( row => {
            row.prefixedName = variables.prefix & row.name;
            return row;
        } );
    }
}
transformer = new PrefixTransformer();
result = queryExecute( "SELECT id, name FROM developers ORDER BY id", [], { transformer: transformer } );
assert isArray( result ) : "testTransformerClassInstanceVariables array";
assert result[1].prefixedName == "USER-Luis Majano" : "testTransformerClassInstanceVariables name";

// testMultipleRegisteredTransformers
result1 = queryExecute( "SELECT id FROM developers", [], { transformer: ( query, metadata ) => query.recordCount } );
assert result1 == 4 : "testMultipleRegisteredTransformers count";
result2 = queryExecute(
    "SELECT id, name FROM developers ORDER BY id",
    [],
    { transformer: ( query, metadata ) => query.recordCount > 0 ? query.getRowAsStruct( 0 ) : null }
);
assert isStruct( result2 ) : "testMultipleRegisteredTransformers row";
assert result2.id == 1 : "testMultipleRegisteredTransformers id";
result3 = queryExecute( "SELECT id, name, role FROM developers", [], { transformer: ( query, metadata ) => query.getColumnList() } );
assert result3 == "ID,NAME,ROLE" : "testMultipleRegisteredTransformers columns";
