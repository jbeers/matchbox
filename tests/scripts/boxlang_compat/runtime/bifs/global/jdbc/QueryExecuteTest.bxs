// boxlang_compat: ortus/boxlang/runtime/bifs/global/jdbc/QueryExecuteTest.java
// The JVM fixture is recreated with the source-level datasource API. The
// MATCHBOX_TEST_DB_HOST environment variable is used by the PostgreSQL test
// datasource when the datasource feature is enabled.

// testMissingDefaultDataSource
threw = false;
try {
    result = queryExecute( "SELECT * FROM developers" );
} catch ( e ) {
    threw = true;
    assert e.message contains "No default datasource" : "testMissingDefaultDataSource message";
}
assert threw : "testMissingDefaultDataSource throws";
assert result == null : "testMissingDefaultDataSource result";

host = getSystemSetting( "MATCHBOX_TEST_DB_HOST", "localhost" );
datasourceConfig = {
    driver: "postgresql",
    host: host,
    port: 5432,
    database: "matchbox_test",
    username: "matchbox",
    password: "matchbox_test",
    maxConnections: 2
};
datasourceRegister( "default", datasourceConfig );

function resetDevelopers() {
    queryExecute( "TRUNCATE TABLE developers" );
    queryExecute( "INSERT INTO developers ( id, name, role, createdAt ) VALUES " &
        "( 77, 'Michael Born', 'Developer', CURRENT_TIMESTAMP )," &
        "( 1, 'Luis Majano', 'CEO', CURRENT_TIMESTAMP )," &
        "( 42, 'Eric Peterson', 'Developer', CURRENT_TIMESTAMP )," &
        "( 9001, 'Bob O''Reily', 'QA', CURRENT_TIMESTAMP )" );
}

queryExecute( "DROP TABLE IF EXISTS developers" );
queryExecute( "CREATE TABLE developers ( id INTEGER, name VARCHAR(155), role VARCHAR(155), createdAt TIMESTAMP )" );
resetDevelopers();

// testSimpleExecute
result = queryExecute( "SELECT * FROM developers ORDER BY id" );
assert isQuery( result ) : "testSimpleExecute query";
assert result.recordCount == 4 : "testSimpleExecute count";
assert result.id[1] == 1 : "testSimpleExecute Luis id";
assert result.name[1] == "Luis Majano" : "testSimpleExecute Luis name";
assert result.role[1] == "CEO" : "testSimpleExecute Luis role";
assert result.id[2] == 42 : "testSimpleExecute Eric id";
assert result.name[2] == "Eric Peterson" : "testSimpleExecute Eric name";
assert result.role[2] == "Developer" : "testSimpleExecute Eric role";
assert result.id[3] == 77 : "testSimpleExecute Michael id";
assert result.name[3] == "Michael Born" : "testSimpleExecute Michael name";
assert result.role[3] == "Developer" : "testSimpleExecute Michael role";

// testArrayBindings
resetDevelopers();
result = queryExecute( "SELECT * FROM developers WHERE id = ?", [ 77 ] );
assert isQuery( result ) : "testArrayBindings query";
assert result.recordCount == 1 : "testArrayBindings count";
assert result.id[1] == 77 : "testArrayBindings id";
assert result.name[1] == "Michael Born" : "testArrayBindings name";
assert result.role[1] == "Developer" : "testArrayBindings role";

// testListStringBindings
resetDevelopers();
result = queryExecute(
    "SELECT * FROM developers WHERE id IN (:ids)",
    { ids: { value: "77,1,42", list: true } }
);
assert isQuery( result ) : "testListStringBindings query";
assert result.recordCount == 3 : "testListStringBindings count";

// testListArrayNamedBindings
resetDevelopers();
result = queryExecute(
    "SELECT * FROM developers WHERE id IN (:ids)",
    { ids: { value: [77, 1, 42], list: true } }
);
assert isQuery( result ) : "testListArrayNamedBindings query";
assert result.recordCount == 3 : "testListArrayNamedBindings count";

// testListArrayPositionalBinding
resetDevelopers();
result = queryExecute(
    "SELECT * FROM developers WHERE id IN (?)",
    [ { value: [77, 1, 42], list: true } ]
);
assert isQuery( result ) : "testListArrayPositionalBinding query";
assert result.recordCount == 3 : "testListArrayPositionalBinding count";

// testParamReuse
resetDevelopers();
result = queryExecute(
    "SELECT * FROM developers WHERE id = :id OR name = :id",
    { id: 77 }
);
assert isQuery( result ) : "testParamReuse query";
assert result.recordCount == 1 : "testParamReuse count";

// testParameterTypeMix
resetDevelopers();
result = queryExecute(
    "SELECT * FROM developers WHERE id = ? OR id IN (?)",
    [ 77, { value: [1, 42], list: true } ]
);
assert isQuery( result ) : "testParameterTypeMix query";
assert result.recordCount == 3 : "testParameterTypeMix count";

// testNamedParamInsideParamArray
resetDevelopers();
result = queryExecute(
    "SELECT * FROM developers WHERE id = :foo",
    [ { name: "foo", value: "1" } ]
);
assert isQuery( result ) : "testNamedParamInsideParamArray query";
assert result.recordCount == 1 : "testNamedParamInsideParamArray count";

// testStructBindings
resetDevelopers();
result = queryExecute( "SELECT * FROM developers WHERE id = :id", { id: 77 } );
assert isQuery( result ) : "testStructBindings query";
assert result.recordCount == 1 : "testStructBindings count";
assert result.id[1] == 77 : "testStructBindings id";
assert result.name[1] == "Michael Born" : "testStructBindings name";
assert result.role[1] == "Developer" : "testStructBindings role";

// testSqlType
resetDevelopers();
result = queryExecute(
    "SELECT * FROM developers WHERE id = :id",
    { id: { value: 77, sqltype: "integer" } }
);
assert isQuery( result ) : "testSqlType query";
assert result.recordCount == 1 : "testSqlType count";
assert result.id[1] == 77 : "testSqlType id";
assert result.name[1] == "Michael Born" : "testSqlType name";
assert result.role[1] == "Developer" : "testSqlType role";

// testCFSqlType
resetDevelopers();
result = queryExecute(
    "SELECT * FROM developers WHERE id = :id",
    { id: { value: 77, sqltype: "cf_sql_integer" } }
);
assert isQuery( result ) : "testCFSqlType query";
assert result.recordCount == 1 : "testCFSqlType count";
assert result.id[1] == 77 : "testCFSqlType id";
assert result.name[1] == "Michael Born" : "testCFSqlType name";
assert result.role[1] == "Developer" : "testCFSqlType role";

// testInvalidSqlType
resetDevelopers();
threw = false;
try {
    result = queryExecute(
        "SELECT * FROM developers WHERE id = :id",
        { id: { value: 77, sqltype: "fooey" } }
    );
} catch ( e ) {
    threw = true;
    assert e.message contains "Unknown QueryColumnType" : "testInvalidSqlType message";
}
assert threw : "testInvalidSqlType throws";

// testMissingStructBinding
resetDevelopers();
threw = false;
try {
    result = queryExecute( "SELECT * FROM developers WHERE id = :id", { name: "Michael Born" } );
} catch ( e ) {
    threw = true;
    assert e.message == "Named parameter [:id] not provided to query." : "testMissingStructBinding message";
}
assert threw : "testMissingStructBinding throws";
assert result == null : "testMissingStructBinding result";

// testNamedDataSource
datasourceRegister( "derby", datasourceConfig );
queryExecute( "DROP TABLE IF EXISTS developers", [], { datasource: "derby" } );
queryExecute( "CREATE TABLE developers ( id INTEGER, name VARCHAR(155), role VARCHAR(155) )", [], { datasource: "derby" } );
queryExecute( "INSERT INTO developers ( id, name, role ) VALUES ( 77, 'Michael Born', 'Developer' )", [], { datasource: "derby" } );
result = queryExecute( "SELECT * FROM developers ORDER BY id", [], { datasource: "derby" } );
assert isQuery( result ) : "testNamedDataSource query";
assert result.recordCount == 1 : "testNamedDataSource count";
assert result.id[1] == 77 : "testNamedDataSource id";
assert result.name[1] == "Michael Born" : "testNamedDataSource name";
assert result.role[1] == "Developer" : "testNamedDataSource role";
queryExecute( "DROP TABLE IF EXISTS developers", [], { datasource: "derby" } );
queryExecute( "CREATE TABLE developers ( id INTEGER, name VARCHAR(155), role VARCHAR(155), createdAt TIMESTAMP )" );
resetDevelopers();

// testNullParam
queryExecute( "DROP TABLE IF EXISTS developers_new", [], { datasource: "derby" } );
queryExecute( "CREATE TABLE developers_new ( id INTEGER, name VARCHAR(155), role VARCHAR(155) )", [], { datasource: "derby" } );
queryExecute(
    "INSERT INTO developers_new ( id, name, role ) VALUES ( :id, :name, :role )",
    { id: 77, name: "Michael Born", role: nullValue() },
    { datasource: "derby" }
);
result = queryExecute( "SELECT * FROM developers_new WHERE id = 77", [], { datasource: "derby" } );
assert isQuery( result ) : "testNullParam query";
assert result.recordCount == 1 : "testNullParam count";
assert result.id[1] == 77 : "testNullParam id";
assert result.name[1] == "Michael Born" : "testNullParam name";
assert result.role[1] == null : "testNullParam role";

