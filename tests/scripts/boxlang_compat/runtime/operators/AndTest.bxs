// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/operators/AndTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// testItCanPerformAnd
assert ( true && true ) : "testItCanPerformAnd true-true";
assert ( true && false ) == false : "testItCanPerformAnd true-false";
assert ( false && true ) == false : "testItCanPerformAnd false-true";
assert ( false && false ) == false : "testItCanPerformAnd false-false";
assert ( "true" && "true" ) : "testItCanPerformAnd str-true-true";
assert ( "true" && "false" ) == false : "testItCanPerformAnd str-true-false";
assert ( "false" && "true" ) == false : "testItCanPerformAnd str-false-true";
assert ( "false" && "false" ) == false : "testItCanPerformAnd str-false-false";
