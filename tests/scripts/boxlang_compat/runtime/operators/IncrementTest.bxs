// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/operators/IncrementTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// SKIPPED (operator not yet implemented): testItCanCompountIncrement exercises
// pre/post increment (`++i` / `i++`), and testIncrementSetThrows expects the
// set-form of increment to throw. MatchBox does not parse `++`/`--` yet, so
// those methods cannot be expressed. The value semantics of the operator are
// transcribed below using `+= 1`.

// testItCanAddNumbers
i = 3;
i += 1;
assert i == 4 : "testItCanAddNumbers 3";
i = 3.5;
i += 1;
assert i == 4.5 : "testItCanAddNumbers 3.5";

// testItCanAddStrings
i = "3";
i += 1;
assert i == 4 : "testItCanAddStrings 3";
i = "3.5";
i += 1;
assert i == 4.5 : "testItCanAddStrings 3.5";
