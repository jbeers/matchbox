// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/operators/MultiplyTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// SKIPPED (JVM-only): testItCanMultiplyNumberToDate operates on a DateTime.

// testItCanMultiplyNumbers
assert ( 3 * 2 ) == 6 : "testItCanMultiplyNumbers 3-2";
assert ( 3.5 * 2.5 ) == 8.75 : "testItCanMultiplyNumbers 3.5-2.5";

// testItCanMultiplyStrings
assert ( "3" * "2" ) == 6 : "testItCanMultiplyStrings 3-2";
assert ( "3.5" * "2.5" ) == 8.75 : "testItCanMultiplyStrings 3.5-2.5";

// testItCanCompountMultiply
i = 4;
i *= 4;
assert i == 16 : "testItCanCompountMultiply";
