// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/operators/BitwiseSignedRightShiftTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
//
// NOTE: `b>>` parses and works for non-negative shift counts; a negative
// shift count (25 b>> -12) panics in MatchBox, so this file fails (red).
// ---------------------------------------------------------------------------

// testNumbers
assert ( -12 b>> 25 ) == -1 : "testNumbers -12-25";
assert ( 25 b>> -12 ) == 0 : "testNumbers 25--12";
assert ( 5 b>> 9 ) == 0 : "testNumbers 5-9";
