// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/operators/EqualsEqualsEqualsTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
//
// NOTE: the `===` strict-equality operator is not parsed by MatchBox yet; this
// file is expected to fail (red) until it lands.
// ---------------------------------------------------------------------------

// SKIPPED (JVM-only): testItCanObeyInheritance compares Java Person class
// instances built in the test harness.

// testItCanCompareObjects
assert ( "Brad" === "Brad" ) : "testItCanCompareObjects str-str";
assert ( "B" === "B" ) : "testItCanCompareObjects str-char";
assert ( true === "true" ) == false : "testItCanCompareObjects bool-str";
assert ( true === true ) : "testItCanCompareObjects bool-bool";
assert ( 1 === "1" ) == false : "testItCanCompareObjects int-str";
assert ( 1 === 1 ) : "testItCanCompareObjects int-int";
assert ( "1" === "true" ) == false : "testItCanCompareObjects str-str2";
assert ( 5 === 5 ) : "testItCanCompareObjects int-int2";
