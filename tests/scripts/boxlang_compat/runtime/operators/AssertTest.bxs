// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/operators/AssertTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// SKIPPED (JVM-only): testItCanAssertUDF builds Java SampleUDF instances via
// reflection; not expressible as BoxLang source evaluation.

// testItCanThrowOnNullValues
threw = false;
try {
    assert ( null ) : "testItCanThrowOnNullValues should throw";
} catch ( e ) {
    threw = true;
}
assert threw : "testItCanThrowOnNullValues";

// testItCanThrowOnFalseValues
threw = false;
try {
    assert ( false ) : "testItCanThrowOnFalseValues should throw";
} catch ( e ) {
    threw = true;
}
assert threw : "testItCanThrowOnFalseValues";

// testItCanAssert
assert ( true ) : "testItCanAssert";

// testNormalExpression
assert ( 2 + 2 ) == 4 : "testNormalExpression";

// testFailingAssert
threw = false;
try {
    assert ( 2 + 2 ) == 5 : "testFailingAssert should throw";
} catch ( e ) {
    threw = true;
}
assert threw : "testFailingAssert";

// testFailingAssertWithMessage
assertMsg = "";
try {
    assert ( 2 + 2 ) == 5 : "Math is broken!";
} catch ( e ) {
    assertMsg = e.message;
}
assert assertMsg contains "Math is broken!" : "testFailingAssertWithMessage";
