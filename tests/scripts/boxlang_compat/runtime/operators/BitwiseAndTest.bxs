// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/operators/BitwiseAndTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// testNumbers
assert ( 12 b& 25 ) == 8 : "testNumbers 12-25";
assert ( 25 b& 12 ) == 8 : "testNumbers 25-12";
assert ( 5 b& 9 ) == 1 : "testNumbers 5-9";
