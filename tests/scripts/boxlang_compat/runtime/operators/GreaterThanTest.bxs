// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/operators/GreaterThanTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// testItCanCompareStrings
assert ( "B" > "A" ) : "testItCanCompareStrings B-A";

// testItCanCompareNumbers
assert ( 2 > 1 ) : "testItCanCompareNumbers 2-1";
assert ( 2.8 > 0.6 ) : "testItCanCompareNumbers 2.8-0.6";

// testItCanCompareStringsAsNumbers
assert ( "2" > "1" ) : "testItCanCompareStringsAsNumbers 2-1";
assert ( "2.8" > "0.6" ) : "testItCanCompareStringsAsNumbers 2.8-0.6";
assert ( "2.8" > "00000.600000" ) : "testItCanCompareStringsAsNumbers 2.8-00000.6";
