// ---------------------------------------------------------------------------
// boxlang_compat: ortus/boxlang/runtime/operators/ElvisTest.java
// MatchBox black-box transfer of the BoxLang JVM test. One block per JVM
// @Test method, using `assert <expr> : "<TestName>"`.
// ---------------------------------------------------------------------------

// testItNullCoalesce
assert ( "left" ?: "right" ) == "left" : "testItNullCoalesce left";
assert ( null ?: "right" ) == "right" : "testItNullCoalesce right";
