// Test queryAddColumn / query.addColumn()
// No database connection required.

q = queryNew("id,name", "integer,varchar")
queryAddRow(q, {id: 1, name: "Alice"})
queryAddRow(q, {id: 2, name: "Bob"})

// Add column with array data
ages = arrayNew()
arrayAppend(ages, 30)
arrayAppend(ages, 25)
q.addColumn("age", "integer", ages)

if (queryColumnCount(q) != 3) {
    throw "Expected 3 columns, got: " & queryColumnCount(q)
}
if (!queryColumnExists(q, "age")) {
    throw "Expected 'age' column to exist"
}

gr1 = q.getRow(1)
if (gr1.age != 30) {
    throw "Expected gr1.age == 30, got: " & gr1.age
}
gr2 = q.getRow(2)
if (gr2.age != 25) {
    throw "Expected gr2.age == 25, got: " & gr2.age
}

// Standalone BIF: add column with defaults
queryAddColumn(q, "score")
if (queryColumnCount(q) != 4) {
    throw "Expected 4 columns after addColumn, got: " & queryColumnCount(q)
}
