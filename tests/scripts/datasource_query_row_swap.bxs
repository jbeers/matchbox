// Test queryRowSwap / query.rowSwap()
// No database connection required.

q = queryNew("id,name", "integer,varchar")
queryAddRow(q, {id: 1, name: "Alice"})
queryAddRow(q, {id: 2, name: "Bob"})
queryAddRow(q, {id: 3, name: "Charlie"})

// Member method: swap rows 1 and 3
q.rowSwap(1, 3)

gr1 = q.getRow(1)
if (gr1.name != "Charlie") {
    throw "Expected row 1 = 'Charlie' after swap, got: " & gr1.name
}
gr3 = q.getRow(3)
if (gr3.name != "Alice") {
    throw "Expected row 3 = 'Alice' after swap, got: " & gr3.name
}

// Standalone BIF: swap rows 2 and 3
queryRowSwap(q, 2, 3)
gr2b = q.getRow(2)
if (gr2b.name != "Alice") {
    throw "Expected row 2 = 'Alice' after second swap, got: " & gr2b.name
}
