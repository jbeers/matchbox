// Tests for the performance-oriented rewrites of arraySort, structSort,
// and arrayUnique in the prelude. Each check throws a descriptive message on
// failure; the integration harness treats any thrown error as a test failure.

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

function expectEq(actual, expected, label) {
    if (actual != expected) {
        throw label & " — expected [" & expected & "] got [" & actual & "]";
    }
}

function expectIntEq(actual, expected, label) {
    if (actual != expected) {
        throw label & " — expected [" & expected & "] got [" & actual & "]";
    }
}

// ---------------------------------------------------------------------------
// arraySort — numbers ascending
// ---------------------------------------------------------------------------

var nums = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5];
arraySort(nums, "numeric", "asc");
expectIntEq(arrayToList(nums), "1,1,2,3,3,4,5,5,5,6,9", "arraySort numeric asc");

// ---------------------------------------------------------------------------
// arraySort — numbers descending
// ---------------------------------------------------------------------------

var numsDesc = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5];
arraySort(numsDesc, "numeric", "desc");
expectIntEq(arrayToList(numsDesc), "9,6,5,5,5,4,3,3,2,1,1", "arraySort numeric desc");

// ---------------------------------------------------------------------------
// arraySort — text ascending (lexicographic via VM `<`)
// ---------------------------------------------------------------------------

var words = ["banana", "apple", "cherry", "Apple"];
arraySort(words, "text", "asc");
expectIntEq(arrayToList(words), "Apple,apple,banana,cherry", "arraySort text asc");

// ---------------------------------------------------------------------------
// arraySort — text descending
// ---------------------------------------------------------------------------

var wordsDesc = ["banana", "apple", "cherry", "Apple"];
arraySort(wordsDesc, "text", "desc");
expectIntEq(arrayToList(wordsDesc), "cherry,banana,apple,Apple", "arraySort text desc");

// ---------------------------------------------------------------------------
// arraySort — already sorted input stays sorted (stability + idempotence)
// ---------------------------------------------------------------------------

var sorted = [1, 2, 3, 4, 5];
arraySort(sorted, "numeric", "asc");
expectIntEq(arrayToList(sorted), "1,2,3,4,5", "arraySort already sorted");

// Reverse-sorted input
var reversed = [5, 4, 3, 2, 1];
arraySort(reversed, "numeric", "asc");
expectIntEq(arrayToList(reversed), "1,2,3,4,5", "arraySort reverse sorted");

// ---------------------------------------------------------------------------
// arraySort — edge cases: empty and single element
// ---------------------------------------------------------------------------

var empty = [];
arraySort(empty, "numeric", "asc");
expectIntEq(len(empty), 0, "arraySort empty keeps length 0");

var single = [42];
arraySort(single, "numeric", "asc");
expectIntEq(single[1], 42, "arraySort single element");

// ---------------------------------------------------------------------------
// arraySort — two elements (covers single merge pass edge case)
// ---------------------------------------------------------------------------

var two = [2, 1];
arraySort(two, "numeric", "asc");
expectIntEq(arrayToList(two), "1,2", "arraySort two elements asc");

var twoDesc = [1, 2];
arraySort(twoDesc, "numeric", "desc");
expectIntEq(arrayToList(twoDesc), "2,1", "arraySort two elements desc");

// ---------------------------------------------------------------------------
// arraySort — stability with already-equal keys (stable sort preserves order)
// We can't tag values directly, but with equal numbers the relative order of
// equal elements should be preserved. Verify with three identical values.
// ---------------------------------------------------------------------------

var dups = [7, 7, 7];
arraySort(dups, "numeric", "asc");
expectIntEq(arrayToList(dups), "7,7,7", "arraySort stability with equal keys");

// ---------------------------------------------------------------------------
// arraySort — power-of-two length (width doubling boundary)
// ---------------------------------------------------------------------------

var pow2 = [];
for (var i = 1; i <= 8; i++) {
    arrayAppend(pow2, 9 - i);
}
// pow2 == [8,7,6,5,4,3,2,1]
arraySort(pow2, "numeric", "asc");
expectIntEq(arrayToList(pow2), "1,2,3,4,5,6,7,8", "arraySort power-of-two length");

// Non-power-of-two length (7) — exercises the ragged final merge.
var ragged = [];
for (var i = 1; i <= 7; i++) {
    arrayAppend(ragged, 8 - i);
}
arraySort(ragged, "numeric", "asc");
expectIntEq(arrayToList(ragged), "1,2,3,4,5,6,7", "arraySort ragged length 7");

// ---------------------------------------------------------------------------
// structSort — returns keys ordered by nested values ascending
// ---------------------------------------------------------------------------

var scores = {};
scores["alice"] = { value: 90 };
scores["bob"] = { value: 70 };
scores["carol"] = { value: 85 };
scores["dave"] = { value: 70 };

var ordered = structSort(scores, "numeric", "asc", "value");
// Ascending by value: bob(70) and dave(70) tie, then carol(85), then alice(90).
expectIntEq(arrayToList(ordered), "bob,dave,carol,alice", "structSort numeric asc");

// Descending.
var orderedDesc = structSort(scores, "numeric", "desc", "value");
expectIntEq(arrayToList(orderedDesc), "alice,carol,bob,dave", "structSort numeric desc");

// structSort stability: bob and dave both have 70; stable sort keeps insertion
// order (bob before dave) for the ascending case.
if (ordered[1] != "bob" || ordered[2] != "dave") {
    throw "structSort stable: expected bob before dave for equal values";
}

// ---------------------------------------------------------------------------
// structSort — text keys
// ---------------------------------------------------------------------------

var labels = {};
labels["k1"] = "zebra";
labels["k2"] = "apple";
labels["k3"] = "mango";
var labelOrder = structSort(labels, "text", "asc");
expectIntEq(arrayToList(labelOrder), "k1,k2,k3", "structSort text asc");

// ---------------------------------------------------------------------------
// structSort — empty and single-element structs
// ---------------------------------------------------------------------------

var emptyStruct = {};
var emptyKeys = structSort(emptyStruct, "numeric", "asc");
expectIntEq(len(emptyKeys), 0, "structSort empty struct");

var singleStruct = {};
singleStruct["only"] = 99;
var singleKeys = structSort(singleStruct, "numeric", "asc");
expectIntEq(len(singleKeys), 1, "structSort single key length");
expectIntEq(singleKeys[1], "only", "structSort single key name");

// ---------------------------------------------------------------------------
// arrayUnique — numbers with duplicates (1 == 1.0 in the VM)
// ---------------------------------------------------------------------------

var numDup = [1, 2, 2, 3, 1, 3, 3, 4];
var numUniq = arrayUnique(numDup);
expectIntEq(arrayToList(numUniq), "1,2,3,4", "arrayUnique numbers");

// Equivalent numeric representations collapse to one entry.
var numEquiv = [1, 1.0];
var numEquivUniq = arrayUnique(numEquiv);
expectIntEq(len(numEquivUniq), 1, "arrayUnique 1 == 1.0 collapses");

// ---------------------------------------------------------------------------
// arrayUnique — strings compared case-insensitively ("Foo" == "foo")
// ---------------------------------------------------------------------------

var strDup = ["foo", "bar", "Foo", "BAR", "baz"];
var strUniq = arrayUnique(strDup);
// Order preserved for first occurrence; "Foo" is a case-dup of "foo", etc.
expectIntEq(len(strUniq), 3, "arrayUnique strings count");
expectIntEq(strUniq[1], "foo", "arrayUnique strings first");
expectIntEq(strUniq[2], "bar", "arrayUnique strings second");
expectIntEq(strUniq[3], "baz", "arrayUnique strings third");

// ---------------------------------------------------------------------------
// arrayUnique — does NOT conflate number 1 with string "1"
// ---------------------------------------------------------------------------

var mixed = [1, "1", 1, "1"];
var mixedUniq = arrayUnique(mixed);
expectIntEq(len(mixedUniq), 2, "arrayUnique 1 and '1' are distinct");
expectIntEq(mixedUniq[1], 1, "arrayUnique mixed first is number 1");
expectIntEq(mixedUniq[2], "1", "arrayUnique mixed second is string '1'");

// ---------------------------------------------------------------------------
// arrayUnique — preserves first-occurrence order
// ---------------------------------------------------------------------------

var orderedDup = [5, 3, 5, 3, 1, 1, 5];
var orderedUniq = arrayUnique(orderedDup);
expectIntEq(arrayToList(orderedUniq), "5,3,1", "arrayUnique preserves order");

// ---------------------------------------------------------------------------
// arrayUnique — edge cases: empty and single element
// ---------------------------------------------------------------------------

expectIntEq(len(arrayUnique([])), 0, "arrayUnique empty");
expectIntEq(len(arrayUnique([42])), 1, "arrayUnique single");

// All-identical input collapses to one element.
var allSame = [9, 9, 9, 9, 9];
expectIntEq(len(arrayUnique(allSame)), 1, "arrayUnique all same");
expectIntEq(arrayUnique(allSame)[1], 9, "arrayUnique all same value");

// ---------------------------------------------------------------------------
// arrayUnique — null and boolean dedup
// ---------------------------------------------------------------------------

var withNull = [null, null, 1, null];
var withNullUniq = arrayUnique(withNull);
expectIntEq(len(withNullUniq), 2, "arrayUnique nulls collapse");

var bools = [true, false, true, false];
var boolUniq = arrayUnique(bools);
expectIntEq(len(boolUniq), 2, "arrayUnique booleans collapse");

println("arraySort / structSort / arrayUnique tests passed");
