// Test structIsOrdered BIF
var s1 = { name: "John", age: 30, city: "Chicago" };

// Plain structs are unordered; use structNew("ordered") for insertion order.
var result1 = structIsOrdered( s1 );
if ( result1 != false ) { throw "structIsOrdered should return false, got: " & result1; }

// Test as method
var result2 = s1.isOrdered();
if ( result2 != false ) { throw "isOrdered() method should return false, got: " & result2; }

// Test with empty struct
var empty = {};
if ( structIsOrdered( empty ) != false ) { throw "empty struct should be unordered"; }

println( "structIsOrdered OK" );
