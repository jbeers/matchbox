// Simple test for type check and format BIFs

// isEmpty
if (!isEmpty("")) { throw "isEmpty empty string failed"; }
if (isEmpty("hello")) { throw "isEmpty non-empty string should be false"; }
if (!isEmpty([])) { throw "isEmpty empty array failed"; }
if (isEmpty([1])) { throw "isEmpty non-empty array should be false"; }
if (!isEmpty(null)) { throw "isEmpty null failed"; }
if (isEmpty(0)) { throw "isEmpty zero should be false"; }
if (isEmpty(1)) { throw "isEmpty non-zero should be false"; }

// isLeapYear
if (!isLeapYear(2000)) { throw "isLeapYear 2000 failed"; }
if (!isLeapYear(2024)) { throw "isLeapYear 2024 failed"; }
if (isLeapYear(1900)) { throw "isLeapYear 1900 should be false"; }
if (isLeapYear(2023)) { throw "isLeapYear 2023 should be false"; }

// isIPv6
if (!isIPv6("::1")) { throw "isIPv6 ::1 failed"; }
if (!isIPv6("2001:db8::1")) { throw "isIPv6 2001:db8::1 failed"; }
if (isIPv6("127.0.0.1")) { throw "isIPv6 ipv4 should be false"; }
if (isIPv6("hello")) { throw "isIPv6 string should be false"; }

// isLocalHost
if (!isLocalHost("localhost")) { throw "isLocalHost localhost failed"; }
if (!isLocalHost("127.0.0.1")) { throw "isLocalHost 127.0.0.1 failed"; }
if (isLocalHost("192.168.1.1")) { throw "isLocalHost 192.168.1.1 should be false"; }

// booleanFormat
if (booleanFormat(true) != "true") { throw "booleanFormat true failed: got " & booleanFormat(true); }
if (booleanFormat(false) != "false") { throw "booleanFormat false failed: got " & booleanFormat(false); }
if (booleanFormat(1) != "true") { throw "booleanFormat 1 failed: got " & booleanFormat(1); }
if (booleanFormat(0) != "false") { throw "booleanFormat 0 failed: got " & booleanFormat(0); }

// decimalFormat
if (decimalFormat(1234.5678) != "1,234.57") { throw "decimalFormat 1234.5678 failed: got " & decimalFormat(1234.5678); }
if (decimalFormat(0) != "0.00") { throw "decimalFormat 0 failed: got " & decimalFormat(0); }

// numberFormat
if (numberFormat(1234567) != "1,234,567") { throw "numberFormat no mask failed: got " & numberFormat(1234567); }
if (numberFormat(0) != "0") { throw "numberFormat 0 failed: got " & numberFormat(0); }

// isValid
if (!isValid("string", "hello")) { throw "isValid string failed"; }
if (!isValid("numeric", 42)) { throw "isValid numeric failed"; }
if (!isValid("integer", 42)) { throw "isValid integer failed"; }
if (!isValid("array", [1, 2, 3])) { throw "isValid array failed"; }
if (!isValid("struct", {a: 1})) { throw "isValid struct failed"; }

// XML type checks
if (!isXML("<root/>")) { throw "isXML should be true"; }
if (isXMLDoc("<root/>")) { throw "isXMLDoc should be false"; }
